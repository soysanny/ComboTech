# ---- Neon / Vercel Postgres (Prisma) ----
# Pooled connection (used by the app at runtime on serverless):
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"
# Direct connection (used by Prisma migrations):
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DBNAME?sslmode=require"

# ---- Auth ----
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# ---- EmailJS (used by contact/notifications, optional) ----
NEXT_PUBLIC_EMAILJS_SERVICE_ID=""
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=""
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=""

# ---- Bakong / payments (optional) ----
BAKONG_CONFIRM_KEY=""
